{
  "name": "@mulenet/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prebuild": "node -e \"const fs=require('fs');const f=['preprod','preview','standalone'].map(n=>'../deployments/'+n+'.json').find(fs.existsSync);if(f)fs.copyFileSync(f,'public/deployment.json')\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
